APP_NAME=Bulk Certificate Generator API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/certificates
REDIS_URL=redis://redis:6379/0
PROCESSING_MODE=celery
STORAGE_DIR=storage/certificates
MAX_RECIPIENTS_PER_JOB=5000
LOG_LEVEL=INFO
CORS_ORIGINS=*
FONT_REGULAR_PATH=
FONT_BOLD_PATH=
FONT_TAMIL_PATH=
